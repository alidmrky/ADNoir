# =============================================================================
# AdNoir — configuration template
# =============================================================================
# Copy to `.env` and adjust. The real `.env` is git-ignored and MUST NOT be committed.
#
# Two consumers read this file:
#   1. docker-compose (via `env_file:`) when running with containers.
#   2. AdNoir's own DotEnv configuration provider, in Development only, when running
#      `dotnet run` directly. Docker is intentionally NOT installed on the current
#      development machine, so path 2 is the normal one here.
#
# The double underscore is ASP.NET Core's configuration section separator:
#   AdNoir__Mongo__ConnectionString  ->  AdNoir:Mongo:ConnectionString
# In `Production` the values must come from real environment variables, not from a file.
# =============================================================================

# --- Environment -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# --- MongoDB -----------------------------------------------------------------
# A replica set is MANDATORY even with a single node: the transactional outbox uses
# multi-document transactions, which standalone mongod does not support.
# Local Windows install:  mongod --replSet rs0   then  rs.initiate()
AdNoir__Mongo__ConnectionString=mongodb://localhost:27017/?replicaSet=rs0
AdNoir__Mongo__DatabaseName=adnoir

# --- Redis (L2 cache, distributed rate limiting) ------------------------------
# Leave EMPTY to run with the in-memory L1 cache only. That is allowed in Development
# and tests; in Production an empty value makes the application fail at startup
# instead of silently degrading.
AdNoir__Redis__ConnectionString=
AdNoir__Redis__InstanceName=adnoir

# --- RabbitMQ ----------------------------------------------------------------
# Leave EMPTY to use MassTransit's in-memory transport. Same fail-fast rule applies:
# an empty value in Production stops the application at startup, because in-memory
# transport loses messages on restart without reporting anything.
AdNoir__RabbitMq__Host=
AdNoir__RabbitMq__Port=5672
AdNoir__RabbitMq__VirtualHost=/
AdNoir__RabbitMq__Username=adnoir
AdNoir__RabbitMq__Password=change-me

# --- JWT / JWKS ---------------------------------------------------------------
# RS256. The private key lives ONLY in the Identity service; every other service
# fetches the public key from /.well-known/jwks.json.
AdNoir__Jwt__Issuer=http://localhost:5080
AdNoir__Jwt__Audience=adnoir
AdNoir__Jwt__AccessTokenMinutes=5
AdNoir__Jwt__RefreshTokenDays=7
AdNoir__Jwt__JwksUri=http://localhost:5080/.well-known/jwks.json

# RSA private key in PEM form, on the Identity service only. Leave empty outside
# Production and a key is generated at startup - convenient, but every issued token
# stops working when the process restarts. In Production an empty value is a startup
# failure, because a key generated per instance means a token signed by one instance
# is rejected by the next.
#
# Generate one with:  openssl genrsa -out adnoir-signing.pem 2048
# Then paste it as a single line with \n escapes, or point at the file contents.
AdNoir__Jwt__PrivateKeyPem=

# --- Seed ---------------------------------------------------------------------
# Run with:  dotnet run --project src/Tools/AdNoir.DbMigrator
# Idempotent: safe to re-run, and re-running after adding a permission updates the
# system roles to include it.
#
# If the password is left empty the migrator generates one, prints it to the console
# EXACTLY ONCE (never to the structured log), and forces a change at first sign-in.
AdNoir__Seed__RootTenantName=AdNoir
AdNoir__Seed__RootTenantSlug=adnoir
AdNoir__Seed__RootOrgUnitName=Head Office
AdNoir__Seed__SuperAdminEmail=admin@adnoir.local
AdNoir__Seed__SuperAdminDisplayName=System Administrator
AdNoir__Seed__SuperAdminPassword=

# --- Observability -----------------------------------------------------------
AdNoir__Otel__ServiceName=adnoir
AdNoir__Otel__OtlpEndpoint=
AdNoir__Serilog__MinimumLevel=Information

# --- Localization --------------------------------------------------
AdNoir__Localization__DefaultCulture=en
AdNoir__Localization__SupportedCultures=en,tr

# --- Identity gRPC client (Sample) --------------------------------------------
# Development uses a separate loopback HTTP/2 endpoint; use HTTPS in other environments.
AdNoir__Identity__GrpcAddress=http://localhost:5082

# --- Gateway --------------------------------------------------------------------
# Local gateway: http://localhost:5070; upstream Identity:5080 and Sample:5090.
# Empty Redis in Development uses per-process limits; Production requires Redis.
AdNoir__Gateway__RateLimitPrefix=adnoir:gateway
AdNoir__Gateway__WindowSeconds=60
AdNoir__Gateway__AuthenticationPermitLimit=10
AdNoir__Gateway__AnonymousPermitLimit=30
AdNoir__Gateway__AuthenticatedPermitLimit=300
# Explicit browser origins only; no wildcard and no trailing slash.
# AdNoir__Gateway__AllowedOrigins__0=http://localhost:5173
# Container profile gateway needs a reachable HTTPS JWKS endpoint and trusted certificate.
# ADNOIR_GATEWAY_JWKS_URI=https://identity.internal/.well-known/jwks.json
# ADNOIR_GATEWAY_IDENTITY_URL=http://host.docker.internal:5080/
# ADNOIR_GATEWAY_SAMPLE_URL=http://host.docker.internal:5090/

# Optional notification service. Keep disabled until RabbitMQ/SMTP and a tenant are configured.
AdNoir__Notification__Enabled=false
AdNoir__RegistrationNotifications__PublishWelcomeEvent=false
AdNoir__Notification__MaxAttempts=5
AdNoir__Notification__RetentionDays=30
AdNoir__Notification__PollSeconds=5
AdNoir__Notification__LeaseSeconds=120
AdNoir__Notification__Smtp__Host=
AdNoir__Notification__Smtp__Port=587
AdNoir__Notification__Smtp__EnableSsl=true
AdNoir__Notification__Smtp__From=
AdNoir__Notification__Smtp__Username=
AdNoir__Notification__Smtp__Password=
AdNoir__Notification__Smtp__TimeoutSeconds=30
# Replace the placeholder with a real tenant GUID before uncommenting.
# AdNoir__Notification__Tenants__TENANT_GUID__Enabled=true

# Required for Sample/Notification gRPC calls. Generate local matching credentials with:
# ./scripts/development/initialize-grpc-credentials.ps1
# See docs/development/grpc-security.md. Never commit real keys.
# AdNoir__Identity__ServiceCredentials__sample__ServiceId=sample
# AdNoir__Identity__ServiceCredentials__sample__Key=BASE64_RANDOM_32_BYTES
# AdNoir__Identity__ServiceCredentials__notification__ServiceId=notification
# AdNoir__Identity__ServiceCredentials__notification__Key=DIFFERENT_BASE64_RANDOM_32_BYTES
# AdNoir__GrpcSecurity__Callers__0__Credential__ServiceId=sample
# AdNoir__GrpcSecurity__Callers__0__Credential__Key=MATCH_SAMPLE_KEY
# AdNoir__GrpcSecurity__Callers__0__CanReadPermissionMatrix=true
# AdNoir__GrpcSecurity__Callers__0__CanValidateUserSession=true
# AdNoir__GrpcSecurity__Callers__0__AllTenants=false
# AdNoir__GrpcSecurity__Callers__0__TenantIds__0=TENANT_GUID
# AdNoir__GrpcSecurity__Callers__1__Credential__ServiceId=notification
# AdNoir__GrpcSecurity__Callers__1__Credential__Key=MATCH_NOTIFICATION_KEY
# AdNoir__GrpcSecurity__Callers__1__CanReadPermissionMatrix=true
# AdNoir__GrpcSecurity__Callers__1__CanValidateUserSession=true
# AdNoir__GrpcSecurity__Callers__1__TenantIds__0=TENANT_GUID
