<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test infrastructure. This is a class library, NOT a test project:
    it holds builders, fakes and fixtures used by the test projects. Keeping it separate
    stops fixtures from being duplicated.
  -->

  <PropertyGroup>
    <RootNamespace>AdNoir.TestKit</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\AdNoir.BuildingBlocks\AdNoir.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
