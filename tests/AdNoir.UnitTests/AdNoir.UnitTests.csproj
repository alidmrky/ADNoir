<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure rules, no MongoDB: hierarchy moves and cycle protection, slug derivation, lockout,
    effective data scope and the role-grant policy are all decidable without a database.
    Turning them into integration tests would make them slower and no more trustworthy.
  -->

  <PropertyGroup>
    <RootNamespace>AdNoir.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Does not make `dotnet test` work on a .NET 10 SDK: that removed the VSTest bridge
      xunit.v3 was reached through, and this property does not restore it. CI runs the
      compiled test host directly instead. See .github/workflows/ci.yml.
    -->
    <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\AdNoir.Shared.Contracts\AdNoir.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Shared\AdNoir.Domain.Abstractions\AdNoir.Domain.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Shared\AdNoir.BuildingBlocks\AdNoir.BuildingBlocks.csproj" />
    <!-- Pure functions only (collection naming, masking). No Mongo connection is opened here. -->
    <ProjectReference Include="..\..\src\Shared\AdNoir.BuildingBlocks.Mongo\AdNoir.BuildingBlocks.Mongo.csproj" />
    <!-- Hierarchy, slug, lockout and scope rules are pure functions; no Mongo connection is opened. -->
    <ProjectReference Include="..\..\src\Services\IdentityAndOrg\AdNoir.IdentityAndOrg.Domain\AdNoir.IdentityAndOrg.Domain.csproj" />
    <!-- RoleGrantPolicy is the privilege-escalation guard. Its repositories are substituted. -->
    <ProjectReference Include="..\..\src\Services\IdentityAndOrg\AdNoir.IdentityAndOrg.Application\AdNoir.IdentityAndOrg.Application.csproj" />
    <ProjectReference Include="..\AdNoir.TestKit\AdNoir.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
