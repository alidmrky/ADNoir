<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Repo-local NuGet configuration.

    <clear /> drops whatever sources happen to be registered on the machine running the
    build, so restore resolves the same way everywhere: locally, in CI, and for anyone
    who clones the repository. Every dependency comes from nuget.org.

    A single source also keeps Central Package Management happy without package source
    mapping (NU1507 is only raised when several sources are configured).
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
