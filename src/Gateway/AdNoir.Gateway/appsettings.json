{
  "AllowedHosts": "*",
  "AdNoir": {
    "Otel": {
      "ServiceName": "adnoir-gateway"
    },
    "Gateway": {
      "AllowedOrigins": [],
      "RateLimitPrefix": "adnoir:gateway",
      "WindowSeconds": 60,
      "AuthenticationPermitLimit": 10,
      "AnonymousPermitLimit": 30,
      "AuthenticatedPermitLimit": 300
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/register",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/refresh",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-logout": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/logout",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-change-password": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/change-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "tenants": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/tenants/{**remainder}"
        }
      },
      "org-units": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/org-units/{**remainder}"
        }
      },
      "users": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/users/{**remainder}"
        }
      },
      "roles": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/roles/{**remainder}"
        }
      },
      "sample-items": {
        "ClusterId": "sample",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/sample-items/{**remainder}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/notifications/emails/{**remainder}", "Methods": ["GET"] }
      },
      "jwks": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/.well-known/jwks.json",
          "Methods": [
            "GET"
          ]
        }
      }
    },
    "Clusters": {
      "notification": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5100/" } }
      },
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5080/"
          }
        }
      },
      "sample": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5090/"
          }
        }
      }
    }
  }
}
