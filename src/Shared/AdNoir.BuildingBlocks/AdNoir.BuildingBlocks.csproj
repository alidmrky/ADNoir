<Project Sdk="Microsoft.NET.Sdk">

  <!--
    References Shared.Contracts and Domain.Abstractions.
    HAS NO MONGODB DEPENDENCY - that separation is what makes "the Application layer is
    independent of the database technology" machine-enforceable, because Application
    references this project but never BuildingBlocks.Mongo.
  -->

  <PropertyGroup>
    <RootNamespace>AdNoir.BuildingBlocks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdNoir.Shared.Contracts\AdNoir.Shared.Contracts.csproj" />
    <ProjectReference Include="..\AdNoir.Domain.Abstractions\AdNoir.Domain.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Scrutor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Message catalog. Shipped with the assembly, versioned in git.

      WithCulture="false" is load-bearing. MSBuild's AssignCulture target reads the ".en." and
      ".tr." in these file names as culture qualifiers - the convention that turns Strings.tr.resx
      into a Turkish satellite assembly - and routes them into en/ and tr/ satellite DLLs instead
      of embedding them in the main assembly. The build stays green and GetManifestResourceStream
      returns null at runtime, which surfaces as "catalog resource not found" on startup.

      LogicalName is explicit for the same reason: the resource name is what the loader looks up,
      so it should be stated rather than derived from a folder path that may be renamed.
    -->
    <EmbeddedResource Include="Messages\Resources\messages.en.json"
                      WithCulture="false"
                      LogicalName="AdNoir.BuildingBlocks.Messages.Resources.messages.en.json" />
    <EmbeddedResource Include="Messages\Resources\messages.tr.json"
                      WithCulture="false"
                      LogicalName="AdNoir.BuildingBlocks.Messages.Resources.messages.tr.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .env parser is internal; its rules are worth testing directly rather than
         through a file on disk. -->
    <InternalsVisibleTo Include="AdNoir.UnitTests" />
  </ItemGroup>

</Project>
