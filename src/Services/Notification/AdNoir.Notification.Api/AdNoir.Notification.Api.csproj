<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The public-facing host. References Infrastructure, Application and
    BuildingBlocks. No MongoDB or MassTransit references here — those are in Infrastructure.
  -->

  <PropertyGroup>
    <RootNamespace>AdNoir.Notification.Api</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdNoir.Notification.Infrastructure\AdNoir.Notification.Infrastructure.csproj" />
    <ProjectReference Include="..\AdNoir.Notification.Application\AdNoir.Notification.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\AdNoir.BuildingBlocks\AdNoir.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.MongoDb" />
    <PackageReference Include="AspNetCore.HealthChecks.Rabbitmq" />
  </ItemGroup>

</Project>
